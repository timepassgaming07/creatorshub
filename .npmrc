# Exact versions only. Coding standards forbid open ranges in package.json.
save-exact=true

# Fail fast when the local Node does not satisfy the engines field, rather than
# producing a confusing runtime error later.
engine-strict=true

# Packages must declare what they import. Relying on hoisting is how a package
# ends up depending on something it never listed.
auto-install-peers=false
strict-peer-dependencies=true
