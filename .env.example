# Copy to .env and adjust. .env is gitignored; this file is not.
# Nothing here is a secret. Every value is a local development default, and
# production values come from the host's secret store, never from a file.
#
# See docs/adr/0015-local-postgres.md for the migrator and app split, and
# docs/adr/0017-authentication-database-role.md for why authentication has a
# third role of its own.

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------

# The application connects as creatorhub_app. This role cannot bypass row-level
# security, which is what makes the second tenant isolation layer real
# (ADR-0012). Do not point this at a superuser: RLS policies are silently
# ignored for superusers, so every isolation test would pass for the wrong
# reason.
DATABASE_URL=postgres://creatorhub_app:creatorhub_local@localhost:5432/creatorhub

# Migrations connect as creatorhub_migrator, which owns the schema. Separating
# this from DATABASE_URL means the running application cannot alter its own
# schema, which is what allows UPDATE and DELETE on ledger_entries to be revoked
# at the role level (ADR-0008).
DATABASE_MIGRATION_URL=postgres://creatorhub_migrator:creatorhub_local@localhost:5432/creatorhub

# Authentication connects as creatorhub_auth (ADR-0017). Sign-in is pre-tenant:
# it has an email and nothing else, so it must read a user row before any
# workspace is known, which the RLS policies correctly deny to creatorhub_app.
#
# This role reaches the authentication tables and no business table, so a
# compromised sign-in path cannot enumerate workspaces. The reverse also holds:
# creatorhub_app has no privilege on sessions, accounts, or verification_tokens,
# so feature code cannot read a password hash or a session token.
#
# Used only by packages/auth. Nothing else should hold this connection string.
DATABASE_AUTH_URL=postgres://creatorhub_auth:creatorhub_local@localhost:5432/creatorhub

# ------------------------------------------------------------------------------
# Local Postgres container
# ------------------------------------------------------------------------------
# Read by docker-compose.yml. Override POSTGRES_PORT if 5432 is already taken;
# remember to change the port in both URLs above to match.

POSTGRES_DB=creatorhub
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
CREATORHUB_APP_PASSWORD=creatorhub_local
CREATORHUB_AUTH_PASSWORD=creatorhub_local
CREATORHUB_MIGRATOR_PASSWORD=creatorhub_local
