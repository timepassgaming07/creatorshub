# Copy to .env and adjust. .env is gitignored; this file is not.
# Nothing here is a secret. Every value is a local development default, and
# production values come from the host's secret store, never from a file.
#
# See docs/adr/0015-local-postgres.md for the migrator and app split, and
# docs/adr/0017-authentication-database-role.md for why authentication has a
# third role of its own.

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------

# The application connects as creatorhub_app. This role cannot bypass row-level
# security, which is what makes the second tenant isolation layer real
# (ADR-0012). Do not point this at a superuser: RLS policies are silently
# ignored for superusers, so every isolation test would pass for the wrong
# reason.
DATABASE_URL=postgres://creatorhub_app:creatorhub_local@localhost:5432/creatorhub

# Migrations connect as creatorhub_migrator, which owns the schema. Separating
# this from DATABASE_URL means the running application cannot alter its own
# schema, which is what allows UPDATE and DELETE on ledger_entries to be revoked
# at the role level (ADR-0008).
DATABASE_MIGRATION_URL=postgres://creatorhub_migrator:creatorhub_local@localhost:5432/creatorhub

# Authentication connects as creatorhub_auth (ADR-0017). Sign-in is pre-tenant:
# it has an email and nothing else, so it must read a user row before any
# workspace is known, which the RLS policies correctly deny to creatorhub_app.
#
# This role reaches the authentication tables and no business table, so a
# compromised sign-in path cannot enumerate workspaces. The reverse also holds:
# creatorhub_app has no privilege on sessions, accounts, or verification_tokens,
# so feature code cannot read a password hash or a session token.
#
# Used only by packages/auth. Nothing else should hold this connection string.
DATABASE_AUTH_URL=postgres://creatorhub_auth:creatorhub_local@localhost:5432/creatorhub

# ------------------------------------------------------------------------------
# Local Postgres container
# ------------------------------------------------------------------------------
# Read by docker-compose.yml. Override POSTGRES_PORT if 5432 is already taken;
# remember to change the port in both URLs above to match.

POSTGRES_DB=creatorhub
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
CREATORHUB_APP_PASSWORD=creatorhub_local
CREATORHUB_AUTH_PASSWORD=creatorhub_local
CREATORHUB_MIGRATOR_PASSWORD=creatorhub_local

# Optional pool tuning for DATABASE_URL. The defaults suit one app instance.
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT=20
# DATABASE_CONNECT_TIMEOUT=10

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------

# The public origin of the app, no trailing slash. Links in emails, download
# links, and the storefront URLs creators share are all built from it.
# Production refuses to start without it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storefronts are served as <subdomain>.<PLATFORM_ROOT_DOMAIN>, which needs
# wildcard DNS and a wildcard certificate. With `localhost` they are served
# at /s/<subdomain> instead.
PLATFORM_ROOT_DOMAIN=localhost

# The hostname a creator points their custom domain at with a CNAME. It must
# route to this app and issue certificates for arbitrary hostnames (an
# on-demand TLS proxy, or the host's custom domain feature). Defaults to
# domains.<PLATFORM_ROOT_DOMAIN>.
# CUSTOM_DOMAIN_TARGET=domains.creatorhub.store

# Salt for the IP hashes kept in audit rows and click deduplication. At least
# 32 characters. Production refuses to start without one. Generate with:
#   openssl rand -hex 32
AUDIT_IP_SALT=

# Only for the end-to-end suite, which runs a production build: allows the
# fake payment, email, storage, and AI adapters, and every checkout shows a
# test-mode banner. A real deployment never sets this.
# CREATORHUB_TEST_MODE=1

# ------------------------------------------------------------------------------
# Authentication (packages/auth, ADR-0017)
# ------------------------------------------------------------------------------

# The origin Better Auth issues cookies and passkeys for. Usually the same as
# NEXT_PUBLIC_APP_URL. A passkey registered on one origin does not work on
# another, so change it with care.
AUTH_BASE_URL=http://localhost:3000

# Signs sessions. At least 64 characters. Rotating it signs everyone out.
#   openssl rand -hex 32
AUTH_SECRET=

# ------------------------------------------------------------------------------
# Payments (ADR-0007, ADR-0016)
# ------------------------------------------------------------------------------

# `razorpay` in production. Development defaults to `memory`, which takes no
# money and is refused in production.
# PAYMENT_PROVIDER=razorpay

# From the Razorpay dashboard: Settings > API Keys. Use test-mode keys
# (rzp_test_...) until the account is activated for live payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Settings > Webhooks. Point the webhook at <NEXT_PUBLIC_APP_URL>/api/webhooks/razorpay
# and subscribe to payment.captured, payment.failed, and refund.processed.
# Without a secret every delivery is refused with 503; there is no default.
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------

# Resend delivers receipts, download links, password resets, and invites.
# Without a key, development prints each email to the server log; production
# refuses to send rather than drop a buyer's links.
RESEND_API_KEY=

# The sender. The domain must be verified in Resend. Each store's name is
# shown as "<Store> via CreatorHub" in front of this address.
EMAIL_FROM=CreatorHub <no-reply@creatorhub.online>

# Reply-to on transactional email, and the contact address on the legal pages.
SUPPORT_EMAIL=

# Payout approvals are emailed here, so someone sends the money and records
# the bank reference with `pnpm operator payout-sent`.
OPERATOR_EMAIL=

# ------------------------------------------------------------------------------
# File storage
# ------------------------------------------------------------------------------

# `local` keeps files on this machine's disk under STORAGE_LOCAL_DIR: fine for
# development or a single server with a persistent volume. Use `s3` or `r2`
# for anything with more than one instance.
STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=.data/storage
# Signs local download URLs. At least 32 characters; falls back to AUTH_SECRET.
# STORAGE_SIGNING_SECRET=

# For s3 or r2. For Cloudflare R2, set STORAGE_ENDPOINT to
# https://<account-id>.r2.cloudflarestorage.com and leave the region as auto.
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=
# STORAGE_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# AI copilot
# ------------------------------------------------------------------------------

# With a key, the copy, storefront, and insights assistants use Claude. Without
# one, production hides the AI buttons; development uses canned output.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ------------------------------------------------------------------------------
# Legal pages
# ------------------------------------------------------------------------------

# Shown on /legal/terms, /legal/privacy, /legal/refunds, and /legal/contact.
# Have the pages reviewed by a lawyer before launch; the text is a starting
# point, not advice.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
